# =============================================================================
# BERU AI AGENT — Environment Variables Template
# =============================================================================
# Copy this file to `.env` and fill in your actual API keys.
#
#   Windows PowerShell:
#     Copy-Item .env.example .env
#     notepad .env
#
#   macOS / Linux:
#     cp .env.example .env
#     nano .env
#
# ⚠️ NEVER commit your real `.env` file. It is listed in `.gitignore`.
# =============================================================================

# ---- LLM Provider API Keys (at least one is required) ----
# Primary: ultra-fast inference (https://console.groq.com/keys)
GROQ_API_KEY=

# Fallback: deep reasoning (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Tertiary: high-capability fallback (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# ---- Optional: Local LLM (Ollama / vLLM / LM Studio) ----
# Default: Ollama on port 11434
LOCAL_LLM_URL=http://127.0.0.1:11434/v1

# ---- Telegram Remote Control (optional) ----
# Create a bot with @BotFather → get TOKEN
# Get your user ID with @userinfobot → get USER_ID
TELEGRAM_TOKEN=
TELEGRAM_USER_ID=

# ---- Model Overrides (optional) ----
# These default to safe values in config.py — only set if you want to override.
BERU_MODEL=llama-3.3-70b-versatile
BERU_GEMINI_MODEL=gemini-2.0-flash
BERU_OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Runtime Tuning (optional) ----
# Maximum ReAct loop rounds (default: 8)
BERU_MAX_ROUNDS=8

# Maximum characters per tool result before truncation (default: 8000)
BERU_TOOL_RESULT_CAP=8000

# Response cache TTL in seconds (default: 60)
BERU_CACHE_TTL=60

# Feature toggles (1 = on, 0 = off)
BERU_PLANNER=1
BERU_CRITIC=1
BERU_REFLECT=1
BERU_STREAMING=1